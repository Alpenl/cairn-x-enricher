# Cairn Share Worker internal enrichment API.
CAIRN_API_BASE_URL=https://share.alpenl.com
CAIRN_ENRICHER_TOKEN=replace-with-a-dedicated-random-token

# OpenAI Responses-compatible xAI endpoint.
GROK_MODELS_BASE_URL=https://tk.alpenl.com/v1
XAI_API_KEY=replace-with-your-api-key
GROK_MODEL=grok-4.6
GROK_MAX_OUTPUT_TOKENS=8192

# Independent semantic classification (server-side only).
TYPESAFE_API_KEY=replace-with-your-typesafe-key
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Scheduler and service settings.
POLL_INTERVAL=5m
REQUEST_TIMEOUT=3m
# Bounds the whole graceful shutdown: the HTTP drain and the in-flight work
# drain share this budget, so keep it below the container's stop_grace_period
# (30s in the provided compose files), or Docker SIGKILLs the process mid-drain.
SHUTDOWN_TIMEOUT=15s
MAX_CONCURRENCY=2
MAX_JOBS_PER_RUN=100
HTTP_ADDR=:8080
LOG_LEVEL=info
